{
    "name": "chatbot-backend",
    "version": "1.0.0",
    "description": "Production-ready WhatsApp/Instagram chatbot platform backend",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix",
        "format": "prettier --write \"src/**/*.js\"",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "db:schema": "node src/database/schema.js"
    },
    "keywords": [
        "chatbot",
        "whatsapp",
        "instagram",
        "scylladb",
        "flow-builder"
    ],  
    "author": "",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.2",
        "bcrypt": "^5.1.1",
        "bullmq": "^5.75.2",
        "cassandra-driver": "^4.7.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "ioredis": "^5.10.1",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "leo-profanity": "^1.9.0",
        "morgan": "^1.10.0",
        "multer": "^2.1.1",
        "slashUtils": "git+ssh://git@git.slashrtc.in:dialerServices/slashUtils.git",
        "socket.io": "^4.6.1",
        "uuid": "^9.0.1",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^4.7.1"
    },
    "devDependencies": {
        "eslint": "^8.55.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.29.1",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
